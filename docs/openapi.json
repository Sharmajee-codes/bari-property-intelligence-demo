{
  "openapi": "3.1.0",
  "info": {
    "title": "Bari Property Intelligence \u2014 Synthetic Demonstration",
    "description": "This repository is an independently developed technical demonstration using synthetic data. It is not affiliated with Immobiliare.it or Gruppo Loseto S.r.l. and does not represent a completed production deployment.\n\nAll prices are asking prices in EUR. Removed listings do not establish a sale. Ground truth is evaluation-only.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/api/v1/properties": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Paginated deduplicated inventory",
        "operationId": "properties_api_v1_properties_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 25,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "municipality",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Municipality"
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(apartment|house|villa)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Property Type"
            }
          },
          {
            "name": "availability",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(active|temporarily_unavailable|removed)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Availability"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_PropertySummary_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/properties/{property_id}": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Property Detail",
        "operationId": "property_detail_api_v1_properties__property_id__get",
        "parameters": [
          {
            "name": "property_id",
            "in": "path",
            "required": true,
            "schema": {
