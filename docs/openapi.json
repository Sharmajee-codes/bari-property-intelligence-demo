    "/api/v1/deduplication/metrics": {
      "get": {
        "tags": [
          "Entity resolution"
        ],
        "summary": "Dedup Metrics",
        "description": "Aggregate evaluation against private synthetic truth; no truth identifiers exposed.",
        "operationId": "dedup_metrics_api_v1_deduplication_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsView"
                }
              }
            }
          }
        }
      }
    }
  },
